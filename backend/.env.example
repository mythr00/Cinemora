# =============================================================================
# CINEMORA backend environment — the complete configuration schema (B-17).
#
# Every variable the backend, its scripts, the deployment supervisor
# (supervise.py) and the root launcher (app.py) read is listed here, with
# its purpose, its actual code default, and whether it is required.
# Variables marked SECRET must never be committed with a real value.
# Copy to .env and fill in real values; never commit a filled .env.
#
# This file is kept honest by tests/test_env_example_parity.py: a new
# env var read in code without an entry here fails the test suite.
# =============================================================================

# --- Required ---------------------------------------------------------------
# SQLAlchemy database URL. PostgreSQL in production
# (postgresql://… resolves to the psycopg v3 driver); the local preview
# stack uses sqlite:///<path>. SECRET (embeds the DB password).
DATABASE_URL=postgresql://cinemora:CHANGE_ME@localhost:5432/cinemora
# Redis for sessions, the RQ job queues, locks and rate buckets.
# Default in most modules: redis://127.0.0.1:6379/0. Effectively
# required — the stack does not run without Redis.
REDIS_URL=redis://localhost:6379/0

# --- LLM provider (BrewKeg) ---------------------------------------------------
# SECRET. Required at first LLM *use*, not at import: the backend boots
# without it and planning falls back to the deterministic Degraded
# Planner, recording degraded_reason "no_key". Read at import time in
# services/llm_client.py — rotation requires a process restart.
BREWKEG_API_KEY=
# LLM provider base URL. Default: https://brewkeg.dev/v1
BREWKEG_BASE_URL=https://brewkeg.dev/v1
# LLM model name. Default: gpt-5-mini
BREWKEG_MODEL=gpt-5-mini

# --- Search (footage/image retrieval) -----------------------------------------
# SECRET. Serper API key — the sole discovery provider. Unset ⇒ asset
# discovery is unconfigured and productions degrade/starve.
SERPER_API_KEY=
# Max concurrent Serper requests. Default: 4
SERPER_MAX_CONCURRENCY=4

# --- Auth, sessions, registration ---------------------------------------------
# SECRET. Legacy operator token (single shared super_admin credential).
# Only honoured while the dual-auth window is open (next variable).
CINEMORA_API_TOKEN=
# Operator-token dual-auth window: 1 = operator token accepted,
# 0 = closed. Default: 0 (closed; E-21). The root launcher and the
# shipped Docker image both default it to 0.
CINEMORA_ALLOW_OPERATOR_TOKEN=0
# Session cookie Secure flag: 1 = HTTPS-only cookies. Default: 1.
# Set 0 only for plain-HTTP local development.
CINEMORA_COOKIE_SECURE=1
# Registration mode: open | invite | closed. Default: open.
CINEMORA_REGISTRATION=open
# SECRET. Invite code required when CINEMORA_REGISTRATION=invite.
CINEMORA_INVITE_CODE=
# Email recognised as the founder/super_admin account (registration +
# scripts/seed_founder.py). Default: the founder's email in
# services/auth.py (FOUNDER_EMAIL_DEFAULT).
CINEMORA_FOUNDER_EMAIL=
# Password file used by scripts/seed_founder.py to write the founder's
# initial password. Default: a founder-initial-password.txt path in
# scripts/seed_founder.py (PASSWORD_FILE_DEFAULT).
CINEMORA_FOUNDER_PASSWORD_FILE=
# API rate limit: POSTs per minute per principal (in-process).
# Default: 30
CINEMORA_API_RATE_LIMIT=30
# Auth rate limit: attempts per minute per IP+email (in-process).
# Default: 10
CINEMORA_AUTH_RATE_LIMIT=10
# CORS allow-list (comma-separated origins). Default in code: empty
# (localhost pair handled in main.py); the root launcher defaults it
# to the production frontend origin.
CINEMORA_CORS_ORIGINS=
# Legacy name recognised ONLY by the assistant's secret-redaction
# denylist (services/assistant/redact.py). Not read as configuration.
CINEMORA_ADMIN_TOKEN=

# --- Public URLs ----------------------------------------------------------------
# Public base URL of the frontend, used to build password-reset links.
# Default: empty (reset links become relative — unusable in email).
CINEMORA_PUBLIC_BASE_URL=
# Public URL of the deployed site, probed by the admin health page.
# NOTE: a different variable from CINEMORA_PUBLIC_BASE_URL for a
# near-identical concept (B-17) — set BOTH, to the same value.
CINEMORA_PUBLIC_URL=

# --- Email (SMTP) ---------------------------------------------------------------
# SMTP host. Unset (with CINEMORA_SMTP_FROM) ⇒ mailer mode "manual":
# nothing is sent; reset links are operator-delivered (B-08/D-09).
CINEMORA_SMTP_HOST=
# SMTP From address. Required together with CINEMORA_SMTP_HOST.
CINEMORA_SMTP_FROM=
# SMTP port. Default: 587
CINEMORA_SMTP_PORT=587
# SMTP username (optional; omit for unauthenticated relays).
CINEMORA_SMTP_USER=
# SECRET. SMTP password.
CINEMORA_SMTP_PASSWORD=
# SMTP STARTTLS: 1 = on. Default: 1.
CINEMORA_SMTP_STARTTLS=1

# --- Workers, dispatcher, runs --------------------------------------------------
# Worker processes per deployment; also the dispatcher's default
# platform cap and an admin-settings display value. Default: 2.
# (worker.py itself does not read it — B-04; supervise.py spawns it.)
CINEMORA_WORKER_COUNT=2
# Platform-wide concurrent-run cap. Default: CINEMORA_WORKER_COUNT.
CINEMORA_PLATFORM_MAX_RUNNING=
# Concurrent renders admitted by the Redis render-slot semaphore.
# Default: 1
CINEMORA_RENDER_CONCURRENCY=1
# Run heartbeat interval, seconds. Default: 30
CINEMORA_RUN_HEARTBEAT_SECONDS=30
# Run considered stale after this many seconds without a heartbeat.
# Default: 180
CINEMORA_RUN_STALE_SECONDS=180
# Stage watchdog timeout, seconds (minimum 60). Default: 3600
CINEMORA_STAGE_WATCHDOG_SECONDS=3600
# Supervisor (supervise.py): 1 = run Alembic migrations before start.
# The shipped Docker image sets 1. Default in code: unset (no migrate).
CINEMORA_RUN_MIGRATIONS=
# Supervisor (supervise.py): 1 = web-only mode (no workers spawned).
CINEMORA_WEB_ONLY=

# --- Storage / media --------------------------------------------------------------
# Media tree root. Default: backend/media/. API and workers MUST agree
# on this or they silently use different trees. Docker steers it to
# /data/media.
CINEMORA_MEDIA_ROOT=
# Source-intelligence SQLite cache path. Default:
# ~/documentary-ai/source_intel.sqlite3 (LOCALAPPDATA-based on Windows).
SOURCE_INTEL_DB=
# Source-profile cache TTL, seconds. Default: 604800 (7 days)
CINEMORA_PROFILE_TTL_SECONDS=604800
# Upload size cap in bytes. Default: 536870912 (512 MiB)
CINEMORA_UPLOAD_MAX_BYTES=536870912
# Candidate acceptance floors for retrieved media.
CINEMORA_MIN_VIDEO_WIDTH=320
CINEMORA_MIN_VIDEO_HEIGHT=240
# Minimum video duration, seconds. Default: 1.0
CINEMORA_MIN_VIDEO_DURATION=1.0
CINEMORA_MIN_IMAGE_WIDTH=320
CINEMORA_MIN_IMAGE_HEIGHT=240

# --- Pipeline behaviour -----------------------------------------------------------
# Rights policy for retrieved footage. Default: allow_all (founder
# ruling 2026-11-21 — watermarked stock allowed and recorded, never
# labelled clean; meme/social sources remain banned in code).
RIGHTS_POLICY=allow_all
# Comma-separated discovery providers to disable. Default: empty.
CINEMORA_DISABLED_PROVIDERS=
# Degraded-planner escape hatch: unset/anything else = Planner 2.0;
# 1/legacy/heuristic/off/0 (see services/degraded_planner.py) selects
# the old heuristic planner. Default: Planner 2.0.
CINEMORA_DEGRADED_PLANNER=
# Final-auditor share gates (MA-35): max share of rotated / positional
# graphics before the auditor flags a production.
CINEMORA_MAX_ROTATION_SHARE=0.5
CINEMORA_MAX_POSITIONAL_SHARE=0.25
# Dynamic per-provider rate buckets (services/rate_bucket.py):
# CINEMORA_<SCOPE>_RPS, e.g. CINEMORA_SERPER_RPS / CINEMORA_LLM_RPS.
# Defaults: serper 20/s, llm 10/s.
# CINEMORA_<SCOPE>_RPS=

# --- Music / mix --------------------------------------------------------------------
# Path to a JSON music catalogue. Unset ⇒ built-in music library empty.
CINEMORA_MUSIC_CATALOGUE=
# Normalise the mixed soundtrack: unset/1/true = on. Default: on.
CINEMORA_MUSIC_NORMALISE=
# Loudness target for measurement + normalisation. Default: -14.0 LUFS
CINEMORA_TARGET_LUFS=-14.0
# True-peak ceiling. Default: -1.0 dBTP
CINEMORA_MAX_TRUE_PEAK_DBTP=-1.0
# Mix overrides (genre-pack preset / built-in default when unset):
CINEMORA_MUSIC_FADE_IN_SECONDS=
CINEMORA_MUSIC_FADE_OUT_SECONDS=
CINEMORA_MUSIC_LOOP_CROSSFADE_SECONDS=
CINEMORA_DUCK_THRESHOLD=
CINEMORA_DUCK_RATIO=
CINEMORA_DUCK_ATTACK_MS=
CINEMORA_DUCK_RELEASE_MS=

# --- Assistant ----------------------------------------------------------------------
# Assistant kill switch: false/0/no/off disables. Default: enabled.
CINEMORA_ASSISTANT_ENABLED=true
# Max tool steps per assistant turn. Default: 8
CINEMORA_ASSISTANT_MAX_STEPS=8
# Assistant turn deadline, seconds. Default: 240
CINEMORA_ASSISTANT_TURN_DEADLINE_SECONDS=240
# Lifetime of a pending action confirmation, seconds (min 30).
# Default: 900
CINEMORA_ASSISTANT_CONFIRM_TTL_SECONDS=900
# Assistant messages per minute per user. Default: 10
CINEMORA_ASSISTANT_MESSAGE_RATE_LIMIT=10

# --- Developer API --------------------------------------------------------------------
# Default per-key request budget per minute on /api/public/v1 when a
# key carries no explicit limit (clamped 1..600). Default: 60
CINEMORA_PUBLIC_API_RATE_LIMIT=60

# --- Runtime / deployment (launchers, Docker, OS) --------------------------------------
# HTTP port for the supervisor (supervise.py). Default: 8000.
# The root launcher (app.py) prefers SERVER_PORT, then PORT,
# then 25585.
PORT=8000
SERVER_PORT=
# Hugging Face model cache (faster-whisper "base" weights download
# here on first use). Docker steers it under /data.
HF_HOME=
# Scratch directory (OS-standard; honoured by Python/tempfile and
# steered under /data by the Docker image).
TMPDIR=
# Windows-only fallback base for the source-intel cache path.
LOCALAPPDATA=
# TLS CA bundle overrides honoured by the media pipeline (standard
# requests/OpenSSL variables). Default: system bundle.
REQUESTS_CA_BUNDLE=
SSL_CERT_FILE=

# --- Frontend only (NOT read by the backend) --------------------------------------------
# Backend URL the deployed frontend proxies /api to (Vercel env).
# Unset ⇒ every proxied API call 503s. Listed here only to prevent
# the recurring confusion (domain B annex §2).
CINEMORA_BACKEND_URL=
