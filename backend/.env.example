# CINEMORA backend environment — copy to .env and fill in real values.
# Never commit a filled .env. All values below are placeholders.

# --- Required ---
# SQLAlchemy database URL (PostgreSQL in production).
DATABASE_URL=postgresql://cinemora:CHANGE_ME@localhost:5432/cinemora
# Redis for the RQ job queue.
REDIS_URL=redis://localhost:6379/0
# LLM provider (BrewKeg proxy) — the backend refuses to import without this set.
BREWKEG_API_KEY=

# --- LLM provider tuning (defaults shown) ---
BREWKEG_BASE_URL=https://brewkeg.dev/v1
BREWKEG_MODEL=gpt-5-mini

# --- Search (footage/image retrieval) ---
SERPER_API_KEY=
SERPER_MAX_CONCURRENCY=4

# --- Source-intelligence cache (optional; default path shown) ---
# SQLite cache of source metadata. Default: ~/documentary-ai/source_intel.sqlite3
SOURCE_INTEL_DB=

# --- Banned providers (IA-05) ---
# Per the founder's PERMANENT directive (2026-11-19), Pexels and Pixabay
# retrieval is banned. Their provider implementations and API keys were
# removed from the backend (IA-05); no configuration for them exists or
# is read by any code path. Do NOT reintroduce them.
