      "{subject} collection:nasa",
      "{subject} subject:(\"structural failure\")"
    ],
    "web": [
      "{query} site:ntsb.gov OR site:nist.gov OR site:loc.gov"
    ],
    "wikimedia_category": [
      "incategory:\"Structural engineering\" {subject}",
      "incategory:\"Building construction\" {subject}"
    ],
    "wikimedia_query": [
