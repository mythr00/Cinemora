    "fade_in_seconds": 1.5,
    "fade_out_seconds": 2.5,
    "music_volume": 0.09
  },
  "music_mood": "Measured, tense underscore — low strings and mechanical pulses (metadata only — no music library is integrated; the soundtrack remains user-supplied or absent).",
  "pacing": {
    "notes": "The sentence target stays informational. Narration is synthesised at the voice provider's native rate — no speed adjustment exists (founder ruling, 2026-11-22).",
