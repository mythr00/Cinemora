  "id": "history",
  "label": "History",
  "mix_preset": {
    "duck_ratio": 8,
    "fade_in_seconds": 2.0,
    "fade_out_seconds": 3.0,
    "music_volume": 0.1
  },
  "music_mood": "Somber orchestral / period instrumentation (metadata only — no music library is integrated; the soundtrack remains user-supplied or absent).",
  "pacing": {
    "notes": "Informational only — narration is not retimed to pacing targets.",
    "target_seconds_per_sentence": 4.5
  },
  "research_query_templates": [
    "{name} {era} historical record",
    "{name} primary sources archive",
    "{name} {place} history"
  ],
  "source_hints": {
    "archive": [
      "collection:prelinger {subject}",
      "creator:(\"Library of Congress\") {subject}",
      "{subject} subject:(\"history\")"
    ],
    "web": [
      "{query} site:loc.gov OR site:archives.gov",
      "{query} site:si.edu OR site:nps.gov"
    ],
    "wikimedia_category": [
      "incategory:\"Historical photographs\" {subject}",
      "incategory:\"Historical maps\" {subject}"
    ],
    "wikimedia_query": [
      "{subject} historical photograph",
      "{subject} archive photograph"
    ]
  },
