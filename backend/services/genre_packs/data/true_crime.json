  "id": "true_crime",
  "label": "True crime",
  "mix_preset": {
    "duck_ratio": 10,
    "fade_in_seconds": 1.0,
    "fade_out_seconds": 2.0,
    "music_volume": 0.08
  },
  "music_mood": "Tense minimal piano and strings (metadata only — no music library is integrated; the soundtrack remains user-supplied or absent).",
  "pacing": {
    "notes": "Informational only — narration is not retimed to pacing targets.",
    "target_seconds_per_sentence": 4.2
  },
  "research_query_templates": [
    "{name} case timeline",
    "{name} court records charges",
    "{name} police investigation"
  ],
  "source_hints": {
    "archive": [
      "creator:(\"Federal Bureau of Investigation\") {subject}",
      "{subject} subject:(\"criminal investigation\")",
      "{subject} subject:(\"police\")"
    ],
    "web": [
      "{query} site:fbi.gov OR site:archives.gov OR site:loc.gov",
      "{query} court records site:loc.gov OR site:archives.gov"
    ],
    "wikimedia_category": [
      "incategory:\"Law enforcement\" {subject}",
      "incategory:\"Crime\" {subject}"
    ],
    "wikimedia_query": [
      "{subject} police investigation",
      "{subject} courthouse"
    ]
  },
