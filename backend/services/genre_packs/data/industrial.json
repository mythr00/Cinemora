  "id": "industrial",
  "label": "Industrial / manufacturing",
  "mix_preset": {
    "duck_ratio": 8,
    "fade_in_seconds": 1.5,
    "fade_out_seconds": 2.5,
    "music_volume": 0.1
  },
  "music_mood": "Driven, rhythmic underscore — muted percussion and low synth pulses (metadata only — no music library is integrated; the soundtrack remains user-supplied or absent).",
  "pacing": {
    "notes": "The sentence target stays informational. Narration is synthesised at the voice provider's native rate — no speed adjustment exists (founder ruling, 2026-11-22).",
    "target_seconds_per_sentence": 4.5
  },
  "research_query_templates": [
    "{name} manufacturing process",
    "{name} production line operations",
    "{name} {place} factory operations"
  ],
  "source_hints": {
    "archive": [
      "collection:prelinger {subject}",
      "{subject} subject:(\"containerization\")",
      "creator:(\"United States Maritime Administration\") {subject}"
    ],
    "web": [
      "{query} port authority operations site:loc.gov OR site:si.edu"
    ],
    "wikimedia_category": [
      "incategory:\"Container terminals\" {subject}",
      "incategory:\"Container ships\" {subject}",
      "incategory:\"Ports\" {subject}"
    ],
    "wikimedia_query": [
      "{subject} container terminal operations"
    ]
  },
